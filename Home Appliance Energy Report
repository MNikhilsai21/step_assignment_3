import java.util.Scanner;

// Using an interface capability flag allows clean extension without relying on if/else checks
interface SupportsSaverMode {}

abstract class Appliance {
    protected double hours;

    public Appliance(double hours) {
        this.hours = hours;
    }

    protected abstract double getPowerRating();

    public double calculateUnits(boolean saverRequested) {
        double units = (getPowerRating() * hours) / 1000.0;
        if (saverRequested && this instanceof SupportsSaverMode) {
            units *= 0.75; // 25% energy reduction
        }
        return units;
    }
}

class Fridge extends Appliance {
    public Fridge(double hours) { super(hours); }
    @Override protected double getPowerRating() { return 150.0; }
}

class AirConditioner extends Appliance implements SupportsSaverMode {
    public AirConditioner(double hours) { super(hours); }
    @Override protected double getPowerRating() { return 1500.0; }
}

class TV extends Appliance {
    public TV(double hours) { super(hours); }
    @Override protected double getPowerRating() { return 100.0; }
}

class WashingMachine extends Appliance implements SupportsSaverMode {
    public WashingMachine(double hours) { super(hours); }
    @Override protected double getPowerRating() { return 500.0; }
}

public class HomeApplianceEnergyReport {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
        double totalCost = 0.0;

        for (int i = 0; i < n; i++) {
            String line = scanner.next().toUpperCase();
            double hours = scanner.nextDouble();
            
            // Read optional SAVER token if it exists on the current line
            String lookahead = scanner.findInLine("SAVER");
            boolean saverRequested = (lookahead != null);

            Appliance appliance;
            switch (line) {
                case "FRIDGE": appliance = new Fridge(hours); break;
                case "AC": appliance = new AirConditioner(hours); break;
                case "TV": appliance = new TV(hours); break;
                case "WASHER": appliance = new WashingMachine(hours); break;
                default: continue;
            }

            if (saverRequested && !(appliance instanceof SupportsSaverMode)) {
                System.out.printf("%s: saver mode not supported\n", line);
            } else {
                double units = appliance.calculateUnits(saverRequested);
                double cost = units * 8.0;
                totalCost += cost;
                System.out.printf("%s: Units=%.2f Cost=%.2f\n", line, units, cost);
            }
        }
        System.out.printf("Total Cost: %.2f\n", totalCost);
        scanner.close();
    }
}
