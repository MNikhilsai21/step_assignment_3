public class Problem2 {
    static String findDuplicatePick(String[] playerNames) {
        // Compare every name against every subsequent name using plain nested loops
        for (int i = 0; i < playerNames.length; i++) {
            for (int j = i + 1; j < playerNames.length; j++) {
                if (playerNames[i].equals(playerNames[j])) {
                    return "Duplicate Found: " + playerNames[i];
                }
            }
        }
        return "No Duplicates Found";
    }

    public static void main(String[] args) {
        String[] sample1 = {"Kohli", "Bumrah", "Kohli", "Rohit"};
        System.out.println(findDuplicatePick(sample1));

        String[] sample2 = {"Kohli", "Bumrah", "Rohit"};
        System.out.println(findDuplicatePick(sample2));
    }
}
