import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public List<List<Integer>> threeSum(int[] nums) {
    List<List<Integer>> result = new ArrayList<>();
    // Sort array to enable systematic two-pointer inward narrowing
    Arrays.sort(nums);
    
    for (int i = 0; i < nums.length - 2; i++) {
        // Skip duplicate values for the first element to avoid identical triplets
        if (i > 0 && nums[i] == nums[i - 1]) {
            continue;
        }
        
        int left = i + 1;
        int right = nums.length - 1;
        
        while (left < right) {
            int sum = nums[i] + nums[left] + nums[right];
            
            if (sum == 0) {
                result.add(Arrays.asList(nums[i], nums[left], nums[right]));
                
                // Move pointers past duplicate entries to guarantee uniqueness
                while (left < right && nums[left] == nums[left + 1]) left++;
                while (left < right && nums[right] == nums[right - 1]) right--;
                
                left++;
                right--;
            } else if (sum < 0) {
                left++; // Target is larger, move left pointer rightward
            } else {
                right--; // Target is smaller, move right pointer leftward
            }
        }
    }
    return result;
}
