public int maxSubArray(int[] nums) {
    // Initialize with the first element to handle single-element or all-negative arrays correctly
    int maxSoFar = nums[0];
    int currentMax = nums[0];
    
    // Kadane's algorithm single-pass scan
    for (int i = 1; i < nums.length; i++) {
        // Core decision: Extend current contiguous subarray or start fresh here
        currentMax = Math.max(nums[i], currentMax + nums[i]);
        maxSoFar = Math.max(maxSoFar, currentMax);
    }
    
    return maxSoFar;
}
