public class IsbnValidator {
    public static String normalizeCode(String raw) {
        if (raw == null) return "";
        // Trim leading and trailing spaces
        String trimmed = raw.trim();
        
        if (trimmed.length() < 3) {
            return trimmed.toUpperCase();
        }
        
        // Uppercase only the first 3 characters and join back the rest
        String firstThree = trimmed.substring(0, 3).toUpperCase();
        String remainder = trimmed.substring(3);
        
        return firstThree + remainder;
    }

    public static void validateAndFormat(String code) {
        // Multi-stage validation constraint processing
        if (code.length() != 13) {
            System.out.println("Invalid: wrong length");
            return;
        }

        // Validate first 3 characters are letters
        for (int i = 0; i < 3; i++) {
            if (!Character.isLetter(code.charAt(i))) {
                System.out.println("Invalid: publisher code must be 3 letters");
                return;
            }
        }

        // Validate the remaining 10 characters are numbers
        for (int i = 3; i < 13; i++) {
            if (!Character.isDigit(code.charAt(i))) {
                System.out.println("Invalid: non-digit body");
                return;
            }
        }

        // Split out the distinct elements for building the visual output token
        String pubCode = code.substring(0, 3);
        String year = code.substring(3, 7);
        String catalog = code.substring(7);

        StringBuilder formatted = new StringBuilder();
        formatted.append("[").append(pubCode).append("] ")
                 .append("YEAR: ").append(year).append(" | ")
                 .append("CATALOG: ").append(catalog);

        System.out.println(formatted.toString());
    }

    public static void main(String[] args) {
        String input1 = normalizeCode(" pen2026004251 ");
        validateAndFormat(input1);

        String input2 = normalizeCode("12N2026004251");
        validateAndFormat(input2);
    }
}
