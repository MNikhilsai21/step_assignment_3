public class InventoryBalancer {
    public static void analyzeInventory(int[] sectionA, int[] sectionB) {
        int totalA = 0;
        int totalB = 0;
        
        int highestQty = Integer.MIN_VALUE;
        String location = "";
        int itemIndex = -1;

        // Accumulate section metrics and scan for maximum inventory count
        for (int i = 0; i < sectionA.length; i++) {
            totalA += sectionA[i];
            totalB += sectionB[i];

            // Evaluate Section A
            if (sectionA[i] > highestQty) {
                highestQty = sectionA[i];
                location = "Section A";
                itemIndex = i + 1; // 1-based display item matching prompt output format
            }

            // Evaluate Section B
            if (sectionB[i] > highestQty) {
                highestQty = sectionB[i];
                location = "Section B";
                itemIndex = i + 1; 
            }
        }

        String status = (totalA == totalB) ? "Balanced" : "Not Balanced";

        System.out.println("Section A Total: " + totalA + " | Section B Total: " + totalB + 
                           " | Status: " + status + " | Highest Quantity: " + highestQty + 
                           " (" + location + ", Item " + itemIndex + ")");
    }

    public static void main(String[] args) {
        int[] sectionA = {20, 15, 30};
        int[] sectionB = {25, 10, 30};
        analyzeInventory(sectionA, sectionB);
    }
}
