import java.util.Scanner;
import java.util.List;
import java.util.ArrayList;

interface Customer {
    double getFinalAmount(double amount);
}

class Student implements Customer {
    @Override
    public double getFinalAmount(double amount) {
        return amount * 0.90; // 10% discount
    }
}

class Staff implements Customer {
    @Override
    public double getFinalAmount(double amount) {
        return amount * 0.95; // 5% discount
    }
}

class Guest implements Customer {
    @Override
    public double getFinalAmount(double amount) {
        return amount + 10.0; // Full amount + ₹10 service charge
    }
}

class Bill {
    private final String customerType;
    private final Customer customer;
    private final double rawAmount;

    public Bill(String customerType, Customer customer, double rawAmount) {
        this.customerType = customerType;
        this.customer = customer;
        this.rawAmount = rawAmount;
    }

    public double calculateFinal() {
        return customer.getFinalAmount(rawAmount);
    }

    public String getCustomerType() {
        return customerType;
    }
}

public class CanteenBillingCounter {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
        
        List<Bill> bills = new ArrayList<>();
        
        for (int i = 0; i < n; i++) {
            String type = scanner.next();
            double amount = scanner.nextDouble();
            
            Customer customer;
            // Simple mapping factory upon ingestion avoids type-checking inside processing loop
            if (type.equalsIgnoreCase("STUDENT")) customer = new Student();
            else if (type.equalsIgnoreCase("STAFF")) customer = new Staff();
            else customer = new Guest();
            
            bills.add(new Bill(type, customer, amount));
        }
        
        double grandTotal = 0;
        for (Bill bill : bills) {
            double finalAmount = bill.calculateFinal(); // Polymorphic behavior execution
            System.out.printf("%s: %.2f\n", bill.getCustomerType(), finalAmount);
            grandTotal += finalAmount;
        }
        System.out.printf("Total: %.2f\n", grandTotal);
        scanner.close();
    }
}
